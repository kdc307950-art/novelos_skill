{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovelOS Literary Benchmark Case v1",
  "type": "object",
  "required": ["id", "source", "type", "text", "context", "question", "answer", "labels", "metadata", "confidence", "verified"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source": {"enum": ["github", "synthetic", "author_authorized"]},
    "type": {"enum": ["01_Continuity", "02_Character", "03_Structure", "04_Literary", "05_Commercial", "06_Failure"]},
    "text": {"type": "string"}, "context": {"type": "string"},
    "question": {"type": "string", "minLength": 1}, "answer": {"type": "string", "minLength": 1},
    "labels": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 10}},
    "details": {"type": "object"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "verified": {"type": "boolean"},
    "metadata": {"type": "object", "required": ["license", "url", "group_id", "split", "status"], "properties": {
      "license": {"type": "string"}, "url": {"type": "string"}, "group_id": {"type": "string"},
      "split": {"enum": ["train", "validation", "test"]}, "status": {"enum": ["pending_review", "reviewed", "rejected"]}
    }}
  },
  "allOf": [{"if": {"properties": {"verified": {"const": true}}}, "then": {"properties": {"metadata": {"required": ["annotation_id", "reviewer", "reviewed_at"]}, "confidence": {"type": "number"}}}}]
}
