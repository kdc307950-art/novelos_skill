{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovelOS Human Calibration Label",
  "type": "object",
  "required": ["sample_id", "expert_score", "comments", "annotator", "confidence"],
  "properties": {"sample_id": {"type": "string"}, "expert_score": {"type": "object", "properties": {"structure": {"type": "number", "minimum": 1, "maximum": 10}, "character": {"type": "number", "minimum": 1, "maximum": 10}, "emotion": {"type": "number", "minimum": 1, "maximum": 10}, "literary": {"type": "number", "minimum": 1, "maximum": 10}}}, "comments": {"type": "array", "items": {"type": "string"}}, "annotator": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}
}
