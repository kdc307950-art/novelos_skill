{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovelOS Three Reviewer Consensus",
  "type": "object",
  "required": ["sample_id", "reviewers", "final", "method", "status"],
  "properties": {"sample_id": {"type": "string"}, "reviewers": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["reviewer_id", "score", "evidence", "confidence"], "properties": {"reviewer_id": {"type": "string"}, "score": {"type": "number", "minimum": 1, "maximum": 10}, "evidence": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}}, "final": {"type": "number", "minimum": 1, "maximum": 10}, "method": {"enum": ["median", "mean", "adjudicated"]}, "status": {"enum": ["pending", "consensus", "disputed"]}}
}
