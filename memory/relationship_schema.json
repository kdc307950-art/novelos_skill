{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovelOS Relationship Record",
  "type": "object",
  "required": ["source", "target", "relation", "polarity", "intensity", "history"],
  "properties": {
    "source": {"type": "string"},
    "target": {"type": "string"},
    "relation": {"type": "string"},
    "polarity": {"type": "string", "enum": ["positive", "negative", "ambivalent", "unknown"]},
    "intensity": {"type": "integer", "minimum": 1, "maximum": 5},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter", "state", "trigger", "evidence"],
        "properties": {
          "chapter": {"type": "string"},
          "state": {"type": "string"},
          "trigger": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}