{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovelOS Memory Change Log",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["change_id", "entity_id", "field", "operation", "old_value", "new_value", "source", "time", "confidence", "status"],
    "properties": {
      "change_id": {"type": "string"},
      "entity_id": {"type": "string"},
      "field": {"type": "string"},
      "operation": {"type": "string", "enum": ["add", "update", "conflict", "revert"]},
      "old_value": {},
      "new_value": {},
      "source": {"type": "string"},
      "time": {"type": "string"},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "status": {"type": "string", "enum": ["pending", "canonical", "rejected"]},
      "supersedes": {"type": ["string", "null"]}
    }
  }
}