{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovelOS Foreshadow Record",
  "type": "object",
  "required": ["id", "name", "introduced_chapter", "hint_level", "expected_payoff", "payoff_chapter", "status"],
  "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "introduced_chapter": {"type": "string"}, "hint_level": {"type": "string", "enum": ["subtle", "medium", "explicit"]}, "expected_payoff": {"type": "string"}, "payoff_chapter": {"type": ["string", "null"]}, "status": {"type": "string", "enum": ["open", "closed", "overdue", "failed"]}, "evidence": {"type": "array", "items": {"type": "string"}}}
}